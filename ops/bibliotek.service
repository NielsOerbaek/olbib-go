[Unit]
Description=Olbib Go, alternate frontend for go.bibliotek.kk.dk
After=network.target
# HOST is docker0 (172.17.0.1) so the Caddy container can reach it; keep retrying until docker0 is up at boot.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/bibliotek-pwa
Environment=HOST=172.17.0.1
Environment=PORT=3800
Environment=LYD_DATA=%h/bibliotek-pwa-data
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
